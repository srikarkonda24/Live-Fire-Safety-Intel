# Copy to `.env.local` and fill in values. Restart `npm run dev` after changes.
#
# Auto-zoom on the map does NOT require a Mapbox/Google key; tiles are public.
# Geocoding uses OSM Nominatim + Open-Meteo (no key). Optional contact email for
# Nominatim fair-use if lookups are rate-limited:
# https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_EMAIL=your-email@example.com

NASA_FIRMS_MAP_KEY=
ANTHROPIC_API_KEY=
WEATHER_API_KEY=
